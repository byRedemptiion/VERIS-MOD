<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <AssemblyName>VerisMod</AssemblyName>
    <RootNamespace>Audely</RootNamespace>
    <ApplicationIcon>Assets\Audely.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
    <Authors>byRedemptiion</Authors>
    <Product>VERIS MOD</Product>
    <Description>VERIS MOD — personnalisation des sons Discord</Description>

    <!-- Démarrage et taille -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mascotte embarquée dans l'exe (un VERIS.png à côté de l'exe la remplace). -->
    <Resource Include="Assets\Audely.ico" />

    <!-- Sons intégrés : copiés à côté de l'exécutable dans sounds\ -->
    <Content Include="Assets\sounds\*.wav" Link="sounds\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\VERIS.png" />
    <Resource Include="Assets\Fonts\*.ttf" />

    <!-- JS du hook : copié tel quel depuis V1.3.7, embarqué dans l'exécutable -->
    <EmbeddedResource Include="Js\audely_runtime_loader.js" LogicalName="Audely.Js.audely_runtime_loader.js" />
    <EmbeddedResource Include="Js\audely_overlay_preload.js" LogicalName="Audely.Js.audely_overlay_preload.js" />
  </ItemGroup>

</Project>

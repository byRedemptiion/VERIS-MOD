<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <AssemblyName>ViiCord</AssemblyName>
    <RootNamespace>ViiCord</RootNamespace>
    <ApplicationIcon>Assets\ViiCord.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <Authors>byRedemptiion</Authors>
    <Product>ViiCord</Product>
    <Description>ViiCord — personnalisation des sons Discord</Description>

    <!-- Démarrage et taille -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mascotte embarquée dans l'exe (un VIIRUS.png à côté de l'exe la remplace). -->
    <Resource Include="Assets\ViiCord.ico" />

    <!-- Sons intégrés : copiés à côté de l'exécutable dans sounds\ -->
    <Content Include="Assets\sounds\*.wav" Link="sounds\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\VIIRUS.png" />
    <Resource Include="Assets\ViiCord_Logo.png" />
    <Resource Include="Assets\ViiCord_Wordmark.png" />
    <Resource Include="Assets\Banners\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />

    <!-- JS du hook : copié tel quel depuis V1.3.7, embarqué dans l'exécutable -->
    <EmbeddedResource Include="Js\viicord_runtime_loader.js" LogicalName="ViiCord.Js.viicord_runtime_loader.js" />
    <EmbeddedResource Include="Js\viicord_overlay_preload.js" LogicalName="ViiCord.Js.viicord_overlay_preload.js" />
  </ItemGroup>

</Project>

<Window x:Class="Audely.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de VERIS MOD" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="/Assets/Fonts/#Manrope, Segoe UI Variable Display, Segoe UI"
        MouseLeftButtonDown="OnDrag">
  <Border BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" Padding="24">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource FieldBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2">
          <Image x:Name="MascotImage" Margin="5" Stretch="Uniform"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="VERIS MOD" FontFamily="{DynamicResource DisplayFont}" FontSize="26" FontWeight="ExtraBold"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource Accent2Brush}" FontSize="12"/>
          <TextBlock x:Name="CreatorText" FontStyle="Italic" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap"
                 Text="VERIS MOD personnalise les sons de Discord : un son, un volume, et un retour au son d'origine en un clic. Nommé d'après V.E.R.I.S, le robot de la mascotte."/>
      <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                 Text="Les réglages sont dans %APPDATA%\Audely. Les fichiers de Discord ne sont modifiés qu'avec une sauvegarde vérifiée (SHA-256), restaurable en un clic via « Désinstaller »."/>
      <Button Content="Fermer" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
              Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Margin="0,20,0,0"/>
    </StackPanel>
  </Border>
</Window>

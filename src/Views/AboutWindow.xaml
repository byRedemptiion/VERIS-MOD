<Window x:Class="ViiCord.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="À propos de ViiCord" Width="640" Height="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="/Assets/Fonts/#Manrope, Segoe UI Variable Display, Segoe UI"
        MouseLeftButtonDown="OnDrag">
  <Border BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <StackPanel Margin="28,26,28,10">

          <!-- Application -->
          <TextBlock Text="APPLICATION" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <TextBlock Text="ViiCord" FontFamily="{DynamicResource DisplayFont}" FontSize="34" FontWeight="ExtraBold" Margin="0,4,0,0"/>
          <TextBlock x:Name="VersionText" Foreground="{DynamicResource Accent2Brush}" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                     Text="ViiCord est une application Windows permettant de personnaliser les sons de Discord et de gérer différents événements audio."/>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>

          <!-- Créateur -->
          <TextBlock Text="CRÉATEUR" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <TextBlock x:Name="CreatorText" Margin="0,6,0,0" FontSize="15" FontWeight="Bold"/>
          <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Conçu et développé par byRedemptiion."/>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>

          <!-- VIIRUS -->
          <TextBlock Text="MASCOTTE" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="104" Height="104" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
              <Image x:Name="MascotImage" Margin="8" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="VIIRUS" FontFamily="{DynamicResource DisplayFont}" FontSize="22" FontWeight="ExtraBold"/>
              <TextBlock Text="VIIRUS — Assistant / mascotte de ViiCord" Foreground="{DynamicResource Accent2Brush}"
                         FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
              <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                         Text="Le petit robot de ViiCord. Sa voix annonce tes événements Discord avec le profil « Voix VIIRUS »."/>
            </StackPanel>
          </Grid>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>

          <!-- Fonctionnalités -->
          <TextBlock Text="FONCTIONNALITÉS" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <ItemsControl x:Name="FeatureList" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3,10,3">
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                  <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20"/>

          <!-- Historique -->
          <TextBlock Text="HISTORIQUE" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <ItemsControl x:Name="HistoryList" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,9">
                  <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="ExtraBold"
                             Foreground="{DynamicResource Accent2Brush}"/>
                  <TextBlock Text="{Binding Notes}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12,0,20"/>

          <!-- Données et sécurité -->
          <TextBlock Text="DONNÉES ET SÉCURITÉ" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="ExtraBold"/>
          <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                     Text="Les réglages, sons et profils sont dans %APPDATA%\ViiCord. Les fichiers de Discord ne sont modifiés qu'avec une sauvegarde vérifiée (SHA-256), restaurable en un clic via « Désinstaller »."/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,1,0,0" Padding="22,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
          <Button x:Name="UpdateButton" Grid.Column="1" Content="Rechercher les mises à jour"
                  Style="{StaticResource CompactButtonStyle}" Height="34" Margin="0,0,10,0" Click="OnCheckUpdate"/>
          <Button Grid.Column="2" Content="Fermer" IsDefault="True" IsCancel="True"
                  Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Height="34"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

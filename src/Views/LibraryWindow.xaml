<Window x:Class="Audely.Views.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VERIS MOD — Bibliothèque" Width="620" Height="520" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Bibliothèque de sons" FontSize="20" FontWeight="Bold"/>
      <TextBlock x:Name="CountText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
    </StackPanel>

    <ListBox x:Name="SoundList" Grid.Row="1" DisplayMemberPath="DisplayName"
             SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnPlay"/>

    <WrapPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right">
      <Button Content="+ Ajouter" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnAdd"/>
      <Button x:Name="PlayButton" Content="▶ Écouter" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnPlay"/>
      <Button x:Name="RenameButton" Content="Renommer" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnRename"/>
      <Button x:Name="DeleteButton" Content="Supprimer" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnDelete"/>
      <Button Content="Fermer" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"/>
    </WrapPanel>
  </Grid>
</Window>

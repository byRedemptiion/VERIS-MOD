<Window x:Class="ViiCord.Views.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ViiCord — Diagnostic" Width="900" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="/Assets/Fonts/#Manrope, Segoe UI Variable Display, Segoe UI">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Diagnostic ViiCord" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="CountText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
      </StackPanel>
      <TextBox x:Name="FilterBox" Grid.Column="1" VerticalAlignment="Center" MinHeight="30"
               Padding="8,4" ToolTip="Filtrer les lignes" TextChanged="OnFilterChanged"/>
    </Grid>

    <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
             FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Actualiser" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnRefresh"/>
      <Button Content="Copier" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnCopy"/>
      <Button Content="Exporter…" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" Click="OnExport"/>
      <Button Content="Fermer" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="90"/>
    </StackPanel>
  </Grid>
</Window>

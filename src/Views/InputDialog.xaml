<Window x:Class="Audely.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VERIS MOD" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        MouseLeftButtonDown="OnDrag">
  <Border BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1" Padding="20">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
      <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBox x:Name="InputBox" MinHeight="32" Padding="8,5" FontSize="13"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Annuler" IsCancel="True" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" MinWidth="86"/>
        <Button Content="OK" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="86" Click="OnOk"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
